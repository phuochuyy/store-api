# Docker ignore file
# Files and directories to exclude from Docker build context

# Git
.git
.gitignore

# Documentation
README.md
DISCOUNT_SYSTEM.md
*.md

# Development files
.env
.env.*
config/application.yml
config/application.yml.example

# Logs
log/*
!log/.keep

# Temporary files
tmp/*
!tmp/.keep

# Test files
test/
spec/
coverage/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Node modules (if any)
node_modules/
yarn-error.log
package-lock.json

# Build artifacts
vendor/bundle
.bundle

# Local development
docker-compose.override.yml