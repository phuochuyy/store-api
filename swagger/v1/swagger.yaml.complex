---
openapi: 3.0.1
info:
  title: Store API V1
  version: v1
  description: RESTful API for an e-commerce store built with Ruby on Rails
  contact:
    name: Store API Support
    email: support@store-api.com
  license:
    name: MIT
    url: https://opensource.org/licenses/MIT

servers:
- url: http://localhost:3000
  description: Development server
- url: https://api.store.com
  description: Production server

tags:
- name: Authentication
  description: User authentication and email verification
- name: Health
  description: System health checks
- name: Products
  description: Product catalog management
- name: Brands
  description: Brand management
- name: Categories
  description: Category management
- name: Shopping Cart
  description: Shopping cart operations
- name: Orders
  description: Order management
- name: Discounts
  description: Discount management
- name: Promotions
  description: Promotion management
- name: Payment Methods
  description: Payment method management
- name: Payments
  description: Payment processing
- name: Notifications
  description: System notifications
- name: Stock Alerts
  description: Stock alert management
- name: Statistics
  description: System statistics and analytics

paths:
  # Health endpoints
  /api/v1/health:
    $ref: './paths/health.yaml#/health'

  # Authentication endpoints
  /api/v1/auth/login:
    $ref: './paths/auth.yaml#/login'
  /api/v1/auth/register:
    $ref: './paths/auth.yaml#/register'
  /api/v1/auth/verify_email:
    $ref: './paths/auth.yaml#/verify_email'
  /api/v1/auth/resend_verification:
    $ref: './paths/auth.yaml#/resend_verification'
  /api/v1/auth/me:
    $ref: './paths/auth.yaml#/me'
  /api/v1/auth/logout:
    $ref: './paths/auth.yaml#/logout'
  /api/v1/auth/refresh_token:
    $ref: './paths/auth.yaml#/refresh_token'
  /api/v1/auth/revoke_all_tokens:
    $ref: './paths/auth.yaml#/revoke_all_tokens'

  # Product endpoints
  /api/v1/products:
    $ref: './paths/products.yaml#/products'
  /api/v1/products/{id}:
    $ref: './paths/products.yaml#/product_by_id'
  /api/v1/products/search:
    $ref: './paths/products.yaml#/search'
  /api/v1/products/{id}/upload_image:
    $ref: './paths/products.yaml#/upload_image'
  /api/v1/products/{id}/remove_image:
    $ref: './paths/products.yaml#/remove_image'
  /api/v1/products/{id}/stock_movements:
    $ref: './paths/products.yaml#/stock_movements'

  # Brand endpoints
  /api/v1/brands:
    $ref: './paths/brands.yaml#/brands'
  /api/v1/brands/{id}:
    $ref: './paths/brands.yaml#/brand_by_id'

  # Category endpoints
  /api/v1/categories:
    $ref: './paths/categories.yaml#/categories'
  /api/v1/categories/{id}:
    $ref: './paths/categories.yaml#/category_by_id'

  # Shopping Cart endpoints
  /api/v1/carts:
    $ref: './paths/carts.yaml#/carts'
  /api/v1/carts/{id}:
    $ref: './paths/carts.yaml#/cart_by_id'
  /api/v1/carts/{id}/clear:
    $ref: './paths/carts.yaml#/clear_cart'
  /api/v1/carts/merge:
    $ref: './paths/carts.yaml#/merge_carts'
  /api/v1/carts/{cart_id}/cart_items:
    $ref: './paths/carts.yaml#/cart_items'
  /api/v1/carts/{cart_id}/cart_items/{id}:
    $ref: './paths/carts.yaml#/cart_item_by_id'

  # Order endpoints
  /api/v1/orders:
    $ref: './paths/orders.yaml#/orders'
  /api/v1/orders/{id}:
    $ref: './paths/orders.yaml#/order_by_id'
  /api/v1/orders/{id}/confirm:
    $ref: './paths/orders.yaml#/confirm_order'
  /api/v1/orders/{id}/cancel:
    $ref: './paths/orders.yaml#/cancel_order'
  /api/v1/orders/{id}/apply_discount:
    $ref: './paths/orders.yaml#/apply_discount'
  /api/v1/orders/{id}/remove_discount:
    $ref: './paths/orders.yaml#/remove_discount'
  /api/v1/orders/{id}/ship:
    $ref: './paths/orders.yaml#/ship_order'
  /api/v1/orders/{id}/deliver:
    $ref: './paths/orders.yaml#/deliver_order'
  /api/v1/orders/{order_id}/order_items:
    $ref: './paths/orders.yaml#/order_items'
  /api/v1/order_items/{id}:
    $ref: './paths/orders.yaml#/order_item_by_id'

  # Discount endpoints
  /api/v1/discounts:
    $ref: './paths/discounts.yaml#/discounts'
  /api/v1/discounts/{id}:
    $ref: './paths/discounts.yaml#/discount_by_id'
  /api/v1/discounts/{id}/stats:
    $ref: './paths/discounts.yaml#/discount_stats'
  /api/v1/discounts/{id}/generate_codes:
    $ref: './paths/discounts.yaml#/generate_codes'
  /api/v1/discounts/validate:
    $ref: './paths/discounts.yaml#/validate_discount'

  # Promotion endpoints
  /api/v1/promotions:
    $ref: './paths/promotions.yaml#/promotions'
  /api/v1/promotions/{id}:
    $ref: './paths/promotions.yaml#/promotion_by_id'
  /api/v1/promotions/{id}/stats:
    $ref: './paths/promotions.yaml#/promotion_stats'
  /api/v1/promotions/{id}/apply:
    $ref: './paths/promotions.yaml#/apply_promotion'
  /api/v1/promotions/applicable:
    $ref: './paths/promotions.yaml#/applicable_promotions'

  # Payment Method endpoints
  /api/v1/payment_methods:
    $ref: './paths/payment_methods.yaml#/payment_methods'
  /api/v1/payment_methods/{id}:
    $ref: './paths/payment_methods.yaml#/payment_method_by_id'
  /api/v1/payment_methods/{id}/stats:
    $ref: './paths/payment_methods.yaml#/payment_method_stats'
  /api/v1/payment_methods/{id}/validate_config:
    $ref: './paths/payment_methods.yaml#/validate_config'
  /api/v1/payment_methods/calculate_fees:
    $ref: './paths/payment_methods.yaml#/calculate_fees'

  # Payment endpoints
  /api/v1/payments:
    $ref: './paths/payments.yaml#/payments'
  /api/v1/payments/{id}:
    $ref: './paths/payments.yaml#/payment_by_id'
  /api/v1/payments/{id}/refund:
    $ref: './paths/payments.yaml#/refund_payment'

  # Notification endpoints
  /api/v1/notifications:
    $ref: './paths/notifications.yaml#/notifications'
  /api/v1/notifications/{id}:
    $ref: './paths/notifications.yaml#/notification_by_id'
  /api/v1/notifications/{id}/mark_read:
    $ref: './paths/notifications.yaml#/mark_read'
  /api/v1/notifications/mark_all_read:
    $ref: './paths/notifications.yaml#/mark_all_read'
  /api/v1/notifications/{id}/mark_unread:
    $ref: './paths/notifications.yaml#/mark_unread'
  /api/v1/notifications/unread_count:
    $ref: './paths/notifications.yaml#/unread_count'
  /api/v1/notifications/recent:
    $ref: './paths/notifications.yaml#/recent'
  /api/v1/notifications/statistics:
    $ref: './paths/notifications.yaml#/statistics'

  # Stock Alert endpoints
  /api/v1/stock_alerts:
    $ref: './paths/stock_alerts.yaml#/stock_alerts'
  /api/v1/stock_alerts/{id}:
    $ref: './paths/stock_alerts.yaml#/stock_alert_by_id'
  /api/v1/stock_alerts/{id}/resolve:
    $ref: './paths/stock_alerts.yaml#/resolve_alert'
  /api/v1/stock_alerts/{id}/dismiss:
    $ref: './paths/stock_alerts.yaml#/dismiss_alert'
  /api/v1/stock_alerts/bulk_operation:
    $ref: './paths/stock_alerts.yaml#/bulk_operation'
  /api/v1/stock_alerts/statistics:
    $ref: './paths/stock_alerts.yaml#/statistics'
  /api/v1/stock_alerts/critical:
    $ref: './paths/stock_alerts.yaml#/critical_alerts'
  /api/v1/stock_alerts/low_stock:
    $ref: './paths/stock_alerts.yaml#/low_stock_alerts'

  # Statistics endpoints
  /api/v1/statistics/dashboard:
    $ref: './paths/statistics.yaml#/dashboard'
  /api/v1/statistics/inventory:
    $ref: './paths/statistics.yaml#/inventory'
  /api/v1/statistics/sales:
    $ref: './paths/statistics.yaml#/sales'

components:
  securitySchemes:
    bearer_auth:
      type: http
      scheme: bearer
      bearerFormat: JWT
      description: JWT token obtained from login endpoint

  schemas:
    $ref: './components/schemas.yaml'

  responses:
    $ref: './components/responses.yaml'

security:
- bearer_auth: []